name: airdrop-linux
version: '@VERSION@'
summary: @SUMMARY@
description: |
@DESCRIPTION@
website: https://github.com/fluffydisk/airdrop-linux
source-code: https://github.com/fluffydisk/airdrop-linux
issues: https://github.com/fluffydisk/airdrop-linux/issues
contact: https://github.com/fluffydisk/airdrop-linux/issues
icon: snap/gui/icon.png
base: core24
grade: stable
confinement: strict
license: MIT
platforms:
  @ARCH@:
    build-on: [@ARCH@]
    build-for: [@ARCH@]
plugs:
  browser-sandbox:
    interface: browser-support
    allow-sandbox: true
apps:
  airdrop-linux:
    command: bin/airdrop-desktop
    extensions: [gnome]
    desktop: usr/share/applications/io.github.fluffydisk.airdrop-linux.desktop
    plugs: [network, network-bind, browser-sandbox]
    environment:
      GTK_USE_PORTAL: '1'
  backend:
    command: bin/airdrop-backend
    daemon: simple
    daemon-scope: user
    install-mode: disable
    restart-condition: on-failure
    plugs: [network, network-bind]
    environment:
      LD_LIBRARY_PATH: $SNAP/usr/lib/@TRIPLET@:$SNAP_LIBRARY_PATH
  cli:
    command: bin/airdrop-cli
    plugs: [network]
    environment:
      LD_LIBRARY_PATH: $SNAP/usr/lib/@TRIPLET@:$SNAP_LIBRARY_PATH
parts:
  airdrop:
    plugin: dump
    stage-packages: [libatomic1, libnss3, libnspr4, libasound2t64, libcups2t64]
    source: '@URL@'
    source-checksum: sha512/@SHA512@
    organize:
      server: lib/airdrop-linux/server
      desktop: lib/airdrop-linux/desktop
      runtime: lib/airdrop-linux/runtime
      ui: lib/airdrop-linux/ui
      distribution.json: lib/airdrop-linux/distribution.json
      LICENSE: lib/airdrop-linux/LICENSE
    override-build: |
      craftctl default
      mkdir -p "$CRAFT_PART_INSTALL/bin" "$CRAFT_PART_INSTALL/usr/share/applications" "$CRAFT_PART_INSTALL/usr/share/icons/hicolor/192x192/apps"
      cat > "$CRAFT_PART_INSTALL/bin/airdrop-desktop" <<'SH'
      #!/bin/sh
      export GTK_USE_PORTAL=1
      exec "$SNAP/lib/airdrop-linux/runtime/node" "$SNAP/lib/airdrop-linux/server/scripts/managed-runtime.js" desktop "$@"
      SH
      cat > "$CRAFT_PART_INSTALL/bin/airdrop-backend" <<'SH'
      #!/bin/sh
      exec "$SNAP/lib/airdrop-linux/runtime/node" "$SNAP/lib/airdrop-linux/server/scripts/managed-runtime.js" backend "$@"
      SH
      cat > "$CRAFT_PART_INSTALL/bin/airdrop-cli" <<'SH'
      #!/bin/sh
      exec "$SNAP/lib/airdrop-linux/runtime/node" "$SNAP/lib/airdrop-linux/server/scripts/managed-runtime.js" cli "$@"
      SH
      chmod 755 "$CRAFT_PART_INSTALL/bin/airdrop-desktop" "$CRAFT_PART_INSTALL/bin/airdrop-backend" "$CRAFT_PART_INSTALL/bin/airdrop-cli"
      cat > "$CRAFT_PART_INSTALL/usr/share/applications/io.github.fluffydisk.airdrop-linux.desktop" <<'DESKTOP'
      [Desktop Entry]
      Type=Application
      Name=Airdrop Linux
      Exec=airdrop-linux
      Icon=${SNAP}/usr/share/icons/hicolor/192x192/apps/io.github.fluffydisk.airdrop-linux.png
      StartupWMClass=io.github.fluffydisk.airdrop-linux
      Categories=Network;FileTransfer;
      DESKTOP
      cp "$CRAFT_PART_INSTALL/ui/icon-192.png" "$CRAFT_PART_INSTALL/usr/share/icons/hicolor/192x192/apps/io.github.fluffydisk.airdrop-linux.png"
