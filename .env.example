# Stored at ~/.local/share/airdrop/config/server.env by default.
# Generate VAPID keys with: npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CONTACT_EMAIL=mailto:example@example.com

# Optional absolute root. Defaults to $XDG_DATA_HOME/airdrop or ~/.local/share/airdrop.
AIRDROP_HOME=
# Optional absolute overrides; normally derived from AIRDROP_HOME.
WATCH_DIR=
AIRDROP_STATE_DIR=
AIRDROP_UI_DIR=

# Local gateway port (UI, /push API and file-server proxy).
PORT=6001
