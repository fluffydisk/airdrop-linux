  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary Button from desktop task controls.",
      "html": "<button class=\"ds-button-primary\">Choose files</button>",
      "css": ".ds-button-primary{font:550 13px/1.4 system-ui,sans-serif;min-height:38px;padding:8px 14px;border:1px solid var(--border,#454d59);border-radius:6px;cursor:pointer;transition:background .15s,color .15s;background:var(--accent,#91b8ff);color:var(--accent-ink,#142b55);border-color:var(--accent,#91b8ff);}.ds-button-primary:hover:not(:disabled){background:var(--accent-strong,#b3ceff);border-color:var(--accent-strong,#b3ceff)}.ds-button-primary:focus-visible{outline:2px solid var(--accent,#91b8ff);outline-offset:3px}.ds-button-primary:disabled{opacity:.5;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button-primary{transition:none}}"
    },
    {
      "name": "Secondary Button",
      "kind": "button",
      "refersTo": "button-secondary",
      "description": "Secondary Button from desktop task controls.",
      "html": "<button class=\"ds-button-secondary\">Choose files</button>",
      "css": ".ds-button-secondary{font:550 13px/1.4 system-ui,sans-serif;min-height:38px;padding:8px 14px;border:1px solid var(--border,#454d59);border-radius:6px;cursor:pointer;transition:background .15s,color .15s;background:var(--surface,#22262d);color:var(--text,#edf0f5);}.ds-button-secondary:hover:not(:disabled){background:var(--surface-hover,#303640)}.ds-button-secondary:focus-visible{outline:2px solid var(--accent,#91b8ff);outline-offset:3px}.ds-button-secondary:disabled{opacity:.5;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button-secondary{transition:none}}"
    },
    {
      "name": "Text Button",
      "kind": "button",
      "refersTo": "button-text",
      "description": "Text Button from desktop task controls.",
      "html": "<button class=\"ds-button-text\">Choose files</button>",
      "css": ".ds-button-text{font:550 13px/1.4 system-ui,sans-serif;min-height:38px;padding:8px 14px;border:1px solid var(--border,#454d59);border-radius:6px;cursor:pointer;transition:background .15s,color .15s;background:transparent;color:var(--accent,#91b8ff);border:0;padding:8px;min-height:34px;font-weight:400;line-height:1.5;}.ds-button-text:hover:not(:disabled){background:var(--accent-tint,#263b5c)}.ds-button-text:focus-visible{outline:2px solid var(--accent,#91b8ff);outline-offset:3px}.ds-button-text:disabled{opacity:.5;cursor:default}@media(prefers-reduced-motion:reduce){.ds-button-text{transition:none}}"
    },
    {
      "name": "Text Field",
      "kind": "input",
      "refersTo": "input",
      "description": "Text Field from the desktop workspace.",
      "html": "<input class=\"ds-field\" aria-label=\"External address\" placeholder=\"https://workspace.example.com\">",
      "css": ".ds-field{font:14px/1.5 system-ui,sans-serif;background:var(--bg,#191c21);color:var(--text,#edf0f5);padding:10px 12px;border:1px solid var(--border,#454d59);border-radius:6px;max-width:100%}.ds-field::placeholder{color:var(--subtle,#aab5c5);opacity:1}.ds-field:focus-visible{outline:2px solid var(--accent,#91b8ff);outline-offset:3px}"
    },
    {
      "name": "Selected Navigation",
      "kind": "nav",
      "refersTo": "navigation-selected",
      "description": "Selected Navigation from the desktop workspace.",
      "html": "<button class=\"ds-nav\" aria-current=\"page\"><svg viewBox=\"0 0 24 24\" aria-hidden=\"true\"><path d=\"M3 7h7l2 2h9v11H3z\"/></svg>Files</button>",
      "css": ".ds-nav{display:flex;align-items:center;gap:10px;padding:11px 12px;font:500 14px/1.5 system-ui,sans-serif;background:var(--accent-tint,#263b5c);color:var(--accent,#91b8ff);border:1px solid var(--accent-tint,#263b5c);border-radius:8px;cursor:pointer}.ds-nav svg{width:20px;height:20px;fill:none;stroke:currentColor;stroke-width:1.7;stroke-linecap:round;stroke-linejoin:round}.ds-nav:hover{color:var(--accent,#91b8ff)}.ds-nav:focus-visible{outline:2px solid var(--accent,#91b8ff);outline-offset:3px}"
    },
    {
      "name": "Queue Count",
      "kind": "chip",
      "refersTo": "count",
      "description": "Queue Count from the desktop workspace.",
      "html": "<span class=\"ds-count\">3</span>",
      "css": ".ds-count{display:inline-block;font:12px/1.5 system-ui,sans-serif;font-variant-numeric:tabular-nums;min-width:24px;padding:1px 6px;text-align:center;border:1px solid var(--border,#454d59);border-radius:4px;color:var(--muted,#bcc4d0)}"
    },
    {
      "name": "Settings Card",
      "kind": "card",
      "refersTo": "settings-card",
      "description": "Settings Card from the desktop workspace.",
      "html": "<section class=\"ds-card\"><h2>Appearance</h2><p>A comfortable view, day or night.</p></section>",
      "css": ".ds-card{background:var(--surface,#22262d);color:var(--text,#edf0f5);border:1px solid var(--border,#454d59);border-radius:8px;padding:24px;font:14px/1.5 system-ui,sans-serif}.ds-card h2{font-size:17px;font-weight:600;margin:0 0 8px}.ds-card p{font-size:13px;line-height:1.6;color:var(--muted,#bcc4d0);max-width:75ch}"
    }
  ],
  "narrative": {
    "northStar": "A quiet, legible Linux workspace",
    "overview": "A quiet, legible Linux workspace. Task clarity and familiar controls carry the identity: Airdrop's paper plane, restrained blue actions, ruled groups, and readable system type. Technical-publication discipline informs headings and annotations without imitating a terminal.\n\nThis system describes the Electron desktop application. The separate mobile PWA retains its existing presentation. Light and dark themes use semantic foreground/background pairs; purple, green, and orange are user-selected accent alternatives.",
    "keyCharacteristics": [
      "Paper-plane identity and restrained action color.",
      "Readable task headings, ruled groups, and predictable alignment.",
      "Text accompanies status color; keyboard focus remains visible."
    ],
    "rules": [
      {
        "name": "The Semantic Pair Rule",
        "body": "Use each theme's matching foreground and background roles together, including the selected accent's ink and tint.",
        "section": "colors"
      },
      {
        "name": "The Quiet Surface Rule",
        "body": "Use borders and tonal layers for ordinary groups; reserve elevation for overlays.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use semantic theme pairs for text, actions, selection, and surfaces.",
      "Do preserve the paper-plane identity and familiar blue default.",
      "Do retain navigation labels as the window narrows.",
      "Do pair state color with descriptive text and honor reduced motion."
    ],
    "donts": [
      "Don't introduce gradients or translucent panels into the desktop workspace.",
      "Don't use decorative hero typography or oversized decoration to displace task controls.",
      "Don't change mobile styles to implement a desktop design adjustment."
    ]
  }
}
