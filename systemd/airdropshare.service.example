# /etc/systemd/system/airdropshare.service
# Installation: copy this file to /etc/systemd/system/, replace <USER>
# with your username, then run:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now airdropshare.service

[Unit]
Description=Airdrop dufs file server
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=<USER>
ExecStart=/usr/local/bin/dufs /home/<USER>/.local/share/airdrop/files --bind 127.0.0.1 --port 5000 --allow-upload --allow-delete --allow-search --allow-archive --render-try-index --hidden .airdrop-*
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
