<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN" "http://www.freedesktop.org/standards/PolicyKit/1/policyconfig.dtd">
<policyconfig>
  <vendor>Airdrop</vendor>
  <action id="io.github.fluffydisk.airdrop.inspect"><description>Inspect Airdrop connection status</description><message>Allow Airdrop to inspect the local connection</message><defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>yes</allow_active></defaults></action>
  <action id="io.github.fluffydisk.airdrop.configure"><description>Configure Airdrop private sharing</description><message>Airdrop needs permission to install or configure Tailscale</message><defaults><allow_any>no</allow_any><allow_inactive>no</allow_inactive><allow_active>auth_admin_keep</allow_active></defaults></action>
</policyconfig>
