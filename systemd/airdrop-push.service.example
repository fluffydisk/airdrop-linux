# /etc/systemd/system/airdrop-push.service
# Installation: copy this file to /etc/systemd/system/, replace <USER>
# with your username, then run:
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now airdrop-push.service

[Unit]
Description=Airdrop push notification server
After=network-online.target tailscaled.service
Wants=network-online.target

[Service]
Type=simple
User=<USER>
WorkingDirectory=/home/<USER>/.local/share/airdrop/app/server
EnvironmentFile=/home/<USER>/.local/share/airdrop/config/server.env
ExecStart=/usr/bin/node /home/<USER>/.local/share/airdrop/app/server/push-server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
